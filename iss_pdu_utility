#!/usr/bin/env python3
import argparse
import sys
import logging

# Ensure the equipment_drivers package is loaded
import equipment_drivers
from equipment_drivers.discovery import discover_and_instantiate

logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')
logger = logging.getLogger("pdu_utility")

def main():
    parser = argparse.ArgumentParser(description="PDU Control Utility")
    parser.add_argument("--ip_address", required=True, help="IP address of the PDU")
    parser.add_argument("--port", type=int, default=161, help="Port of the PDU (default: 161)")
    parser.add_argument("action", choices=["on", "off", "status"], help="Action to perform")
    parser.add_argument("channel", type=int, help="Channel number")

    args = parser.parse_args()

    # Discover and instantiate driver
    driver = discover_and_instantiate(args.ip_address, args.port, "pdu")
    if not driver:
        logger.error("Failed to detect PDU model or find suitable driver.")
        sys.exit(1)

    try:
        driver.connect(args.ip_address, args.port)
        print(f"Detected Model: {driver.get_model()}")

        if args.action == "on":
            result, raw = driver.turn_on(args.channel)
            print(f"Channel {args.channel} turned ON successfully.")
            print(f"RAW_OUTPUT:\n{raw}")
        elif args.action == "off":
            result, raw = driver.turn_off(args.channel)
            print(f"Channel {args.channel} turned OFF successfully.")
            print(f"RAW_OUTPUT:\n{raw}")
        elif args.action == "status":
            status, raw = driver.get_status(args.channel)
            print(f"Channel {args.channel} Status: {status}")
            print(f"RAW_OUTPUT:\n{raw}")

    except Exception as e:
        logger.error(f"Error executing action: {e}")
        sys.exit(1)
    finally:
        driver.disconnect()

if __name__ == "__main__":
    main()
