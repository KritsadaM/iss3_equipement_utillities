#!/usr/bin/env python3
"""
ISS Equipment Blackbox Trial & Diagnostic Tool
Allows operators and developers to trial any equipment model offline using simulated
mock hardware, inspect raw responses, test actions, and verify driver logic with ZERO real hardware.
"""
import argparse
import sys
import time

# Ensure equipment_drivers is importable
import equipment_drivers
from equipment_drivers.registry import registry
from equipment_drivers.simulator import (
    MockPduServer,
    run_pdu_blackbox_trial,
    run_pdu_mock_action,
    determine_vendor,
    BOLD,
    RESET,
    CYAN,
    RED,
    GREEN,
    YELLOW,
)


def print_banner():
    print(f"""
{CYAN}{BOLD}========================================================================
  ISS Equipment Blackbox Trial & Diagnostic Tool (Mock Simulation Mode)
  Test and inspect raw device responses without requiring real hardware
========================================================================{RESET}
""")


def list_models():
    """Prints a formatted table of all registered equipment models."""
    print(f"\n{BOLD}Supported Hardware Equipment Models:{RESET}\n")

    for eq_type in ("pdu", "terminal_server", "daq"):
        drivers = registry.get_all_drivers(eq_type)
        if not drivers:
            continue

        print(f"{CYAN}{BOLD}--- {eq_type.upper()} Drivers ({len(drivers)} models) ---{RESET}")
        print(f"{'Signature':<22} | {'Max Ch':<8} | {'Model Display Name'}")
        print("-" * 75)

        for sig, driver_cls in drivers:
            try:
                inst = driver_cls()
                model_name = inst.get_model()
                max_ch = inst.get_max_channel() if hasattr(inst, "get_max_channel") else "-"
            except Exception:
                model_name = driver_cls.__name__
                max_ch = "-"

            print(f"{sig:<22} | {str(max_ch):<8} | {model_name}")
        print()


def trial_vendor_models(vendor: str):
    """Runs blackbox trial on all models of a specific vendor non-interactively."""
    all_drivers = registry.get_all_drivers("pdu")
    matching = [(sig, cls) for sig, cls in all_drivers if determine_vendor(sig, cls) == vendor]

    if not matching:
        print(f"{RED}No drivers found for vendor '{vendor}'{RESET}")
        return

    print(f"\n{BOLD}Executing Mock Blackbox Trials on ALL {len(matching)} {vendor.upper()} Models...{RESET}\n")
    passed_count = 0
    start_time = time.time()
    for sig, cls in matching:
        if run_pdu_blackbox_trial(sig, cls):
            passed_count += 1
    elapsed = time.time() - start_time
    print(f"\n{BOLD}Summary: {passed_count}/{len(matching)} {vendor.upper()} models passed all mock checks in {elapsed:.2f}s.{RESET}\n")


def interactive_vendor_menu(vendor: str):
    all_drivers = registry.get_all_drivers("pdu")
    matching = [(sig, cls) for sig, cls in all_drivers if determine_vendor(sig, cls) == vendor]

    if not matching:
        print(f"{RED}No drivers found for vendor '{vendor}'{RESET}")
        return

    while True:
        print(f"\n{BOLD}Select Model to Trial ({vendor.upper()}):{RESET}")
        for i, (sig, cls) in enumerate(matching, 1):
            inst = cls()
            print(f"  [{i:2d}] {inst.get_model():<45} (sig: {sig}, outlets: {inst.get_max_channel()})")
        print("  [ A] Test ALL models of this vendor")
        print("  [ B] Back to main menu")

        choice = input(f"\nEnter choice: ").strip().upper()
        if choice == "B":
            return
        elif choice == "A":
            trial_vendor_models(vendor)
            return
        else:
            try:
                idx = int(choice) - 1
                if 0 <= idx < len(matching):
                    sig, cls = matching[idx]
                    run_pdu_blackbox_trial(sig, cls)
                else:
                    print(f"{RED}Invalid selection.{RESET}")
            except ValueError:
                print(f"{RED}Invalid input.{RESET}")


def interactive_mode():
    """Interactive CLI menu to choose vendor and model for manual trial."""
    print_banner()
    vendors = ["APC", "WTI", "Raritan", "Dummy"]

    while True:
        print(f"\n{BOLD}Select Equipment Vendor for Trial:{RESET}")
        for i, v in enumerate(vendors, 1):
            print(f"  [{i}] {v}")
        print("  [A] Run All Models")
        print("  [Q] Quit")

        choice = input(f"\nEnter choice: ").strip().upper()
        if choice == "Q":
            print("Exiting trial tool.")
            break
        elif choice == "A":
            run_all_trials()
            break

        try:
            vendor_idx = int(choice) - 1
            if 0 <= vendor_idx < len(vendors):
                chosen_vendor = vendors[vendor_idx].lower()
                interactive_vendor_menu(chosen_vendor)
            else:
                print(f"{RED}Invalid selection.{RESET}")
        except ValueError:
            print(f"{RED}Invalid input.{RESET}")


def run_all_trials():
    all_drivers = registry.get_all_drivers("pdu")
    print(f"\n{BOLD}Executing Mock Blackbox Trial on ALL {len(all_drivers)} PDU Models...{RESET}\n")
    passed = 0
    start_time = time.time()

    for sig, cls in all_drivers:
        if run_pdu_blackbox_trial(sig, cls):
            passed += 1

    elapsed = time.time() - start_time
    print(f"\n{BOLD}========================================================================")
    print(f" FINAL REPORT: {passed}/{len(all_drivers)} Models Passed in {elapsed:.2f}s")
    print(f"========================================================================{RESET}\n")


def main():
    parser = argparse.ArgumentParser(
        description="ISS Equipment Blackbox Trial & Testing Tool (Mock Simulation Mode)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # View all supported model signatures
  ./iss_trial_utility --list

  # Run full 9-step mock blackbox trial on a specific model
  ./iss_trial_utility --model apc_ap7900
  ./iss_trial_utility --model wti_vmr_hd4d20
  ./iss_trial_utility --model raritan_px3_5460

  # Execute specific mock action and inspect raw response
  ./iss_trial_utility --model apc_ap7900 --action on --channel 1
  ./iss_trial_utility --model apc_ap7900 --action status --channel 1-3
  ./iss_trial_utility --model wti_vmr_hd4d20 --action off --channel 2

  # Run trials on all models of a vendor
  ./iss_trial_utility --vendor apc
  ./iss_trial_utility --vendor wti
  ./iss_trial_utility --vendor raritan

  # Run trials on all models
  ./iss_trial_utility --all
        """
    )
    parser.add_argument("--list", action="store_true", help="List all registered hardware models and exit")
    parser.add_argument("--model", type=str, default=None, help="Signature of the model to trial (e.g. apc_ap7900, wti_vmr_hd4d20, raritan_px3_5460)")
    parser.add_argument("--action", type=str, choices=["trial", "on", "off", "status"], default="trial",
                        help="Action to execute: 'trial' (full 9-phase trial), 'on', 'off', or 'status' (default: trial)")
    parser.add_argument("--channel", type=str, default="1", help="Channel specification for action test (default: '1', supports '1,2' or '1-3')")
    parser.add_argument("--vendor", type=str, choices=["apc", "wti", "raritan", "dummy"], help="Run trials on all models of a specific vendor")
    parser.add_argument("--all", action="store_true", help="Run mock blackbox trial across all registered models")
    parser.add_argument("--ip_address", type=str, default=None, help="Ignored in mock mode (kept for CLI argument compatibility)")
    parser.add_argument("--port", type=int, default=None, help="Ignored in mock mode (kept for CLI argument compatibility)")
    parser.add_argument("--interactive", action="store_true", help="Launch interactive model trial menu")

    args = parser.parse_args()

    if args.list:
        print_banner()
        list_models()
        sys.exit(0)

    if args.all:
        print_banner()
        run_all_trials()
        sys.exit(0)

    if args.vendor:
        print_banner()
        trial_vendor_models(args.vendor)
        sys.exit(0)

    if args.model:
        print_banner()
        driver_cls = registry.get_driver("pdu", args.model)
        if not driver_cls:
            print(f"{RED}Error: Model signature '{args.model}' not found in registry.{RESET}")
            print("Use --list to view all available model signatures.")
            sys.exit(1)

        if args.action == "trial":
            success = run_pdu_blackbox_trial(args.model, driver_cls)
        else:
            success = run_pdu_mock_action(args.model, driver_cls, action=args.action, channel_spec=args.channel)
        sys.exit(0 if success else 1)

    # If no arguments given or --interactive flag specified, launch interactive mode
    if len(sys.argv) == 1 or args.interactive:
        interactive_mode()
        sys.exit(0)

    parser.print_help()


if __name__ == "__main__":
    main()
