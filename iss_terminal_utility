#!/usr/bin/env python3
import argparse
import os
import sys
import logging

import equipment_drivers
from equipment_drivers.discovery import discover_and_instantiate

logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')
logger = logging.getLogger("terminal_utility")

def main():
    parser = argparse.ArgumentParser(description="Terminal Server Utility")
    parser.add_argument("--ip_address", required=True, help="IP address of the Terminal Server")
    parser.add_argument("--port", type=int, default=22, help="Port of the Terminal Server (default: 22)")
    parser.add_argument("--username", default=None,
                         help="Username override for the Terminal Server (falls back to TS_USERNAME env var, then driver default)")
    parser.add_argument("--password", default=None,
                         help="Password override for the Terminal Server (falls back to TS_PASSWORD env var, then driver default). "
                              "Prefer the env var over this flag to avoid the password showing up in shell history.")

    args = parser.parse_args()
    username = args.username or os.environ.get("TS_USERNAME")
    password = args.password or os.environ.get("TS_PASSWORD")

    driver = discover_and_instantiate(args.ip_address, args.port, "terminal_server")
    if not driver:
        logger.error("Failed to detect Terminal Server model or find suitable driver.")
        sys.exit(1)

    try:
        connected = driver.connect(args.ip_address, args.port, username=username, password=password)
        if not connected:
            logger.error("Failed to connect to Terminal Server.")
            sys.exit(1)
        print(f"Detected Model: {driver.get_model()}")

        # For Terminal server we just dump status as basic example
        status, raw = driver.get_status()
        print(f"Terminal Server Status:\n{status}")
        print(f"RAW_OUTPUT:\n{raw}")

    except Exception as e:
        logger.error(f"Error executing action: {e}")
        sys.exit(1)
    finally:
        driver.disconnect()

if __name__ == "__main__":
    main()
